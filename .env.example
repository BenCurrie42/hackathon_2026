# Copy to .env (which git ignores) and fill in.
ANTHROPIC_API_KEY=

# Optional: pick the Claude model and how hard it thinks.
# HOLYSOUND_MODEL=claude-opus-5-5
# HOLYSOUND_EFFORT=medium

# Or use an open model through OpenCode Go (https://opencode.ai/docs/go/).
# With only OPENCODE_API_KEY set, Holy Sound picks OpenCode Go on its own.
# HOLYSOUND_PROVIDER=opencode-go
# OPENCODE_API_KEY=
# HOLYSOUND_MODEL=kimi-k3      # `uv run python -m app --list-models` shows the rest
# HOLYSOUND_BASE_URL=https://opencode.ai/zen/go/v1
